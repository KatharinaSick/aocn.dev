# Dependencies
node_modules/

# Build output
dist/
.astro/
.netlify/

# Environment
.env
.env.local
.env.*.local

# OpenTofu / Terraform
# .terraform.lock.hcl is intentionally committed: it pins provider versions.
infra/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
# There is no tfvars file — variables carry defaults. Ignored so one added later
# cannot be committed by accident.
*.tfvars
crash.log
crash.*.log

# devbox
.devbox/
logfile
# The pinned toolchain must be committed. Negated explicitly because a global
# gitignore may exclude devbox.* — repo rules win, so this keeps the repo correct
# regardless of local git config.
!devbox.json
!devbox.lock

# Editors
.idea/
.vscode/
*.iml

# OS
.DS_Store

# Logs
*.log
npm-debug.log*

tmp