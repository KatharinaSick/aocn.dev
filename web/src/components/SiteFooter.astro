---
// The footer on every page: the domain and the vim keys hint on the left, the GitHub mark
// in the middle, the supporter on the right. Everything stays muted; links are underlined.
//
// The vim keys hint is a button: it opens the ? help overlay, so the keys can be found,
// and switched back on, without the keyboard.

// The website repository for now. Once the challenges repository is public, this may
// point to where all of the project's repositories are.
const GITHUB_URL = 'https://github.com/KatharinaSick/aocn.dev';
---

<footer class="siteFooter">
  <span class="siteFooterLeft">
    aocn.dev ·{' '}
    <button class="siteFooterVim" type="button" data-vim-help>
      <span class="siteFooterVimOn">press <span class="siteFooterKey">?</span> for vim keys</span>
      <span class="siteFooterVimOff">vim keys are off</span>
    </button>
  </span>
  <a class="siteFooterGithub" href={GITHUB_URL} target="_blank" rel="noopener" aria-label="GitHub">
    <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
      <path
        d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"
      ></path>
    </svg>
  </a>
  <span class="siteFooterRight">
    supported with <span class="siteFooterHeart" aria-hidden="true">&lt;3</span><span class="srOnly">love</span> by{' '}
    <a class="siteFooterLink" href="https://www.dynatrace.com" target="_blank" rel="sponsored noopener">Dynatrace</a>
  </span>
</footer>

<style>
  /* Three columns, so the GitHub mark sits in the exact middle whatever the sides say. */
  .siteFooter {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-6);
    padding: var(--space-6) var(--page-gutter);
    border-top: 1px solid var(--color-line);
    color: var(--color-muted);
    font-size: var(--font-size-small);
    line-height: var(--line-height-small);
  }

  .siteFooterVim {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font-size: inherit;
    line-height: inherit;
    cursor: pointer;
  }

  .siteFooterVim:hover {
    color: var(--color-text);
  }

  .siteFooterKey {
    color: var(--color-text);
  }

  /* VimKeys sets data-vim-keys on <html> when someone switches the keys off. */
  .siteFooterVimOff,
  :global(html[data-vim-keys='off']) .siteFooterVimOn {
    display: none;
  }

  :global(html[data-vim-keys='off']) .siteFooterVimOff {
    display: inline;
  }

  .siteFooterRight {
    justify-self: end;
  }

  .siteFooterGithub {
    display: flex;
    color: var(--color-muted);
  }

  .siteFooterGithub svg {
    fill: currentColor;
  }

  .siteFooterGithub:hover,
  .siteFooterLink:hover {
    color: var(--color-text);
  }

  /* Muted like the rest of the footer, underlined so it reads as a link. */
  .siteFooterLink {
    color: inherit;
  }

  /* A terminal heart, not an emoji: the site has none. */
  .siteFooterHeart {
    color: var(--color-aurora);
  }
</style>
