---
// A page of plain reading text: the command that "opened" it, a title, and the text in one
// readable column. For the pages that are information rather than story (privacy, imprint).
//
// The text is the slot. Headings, paragraphs, lists and links inside it get their look
// here, so the pages themselves stay plain HTML.

interface Props {
  /** The shell line above the title, e.g. "$ cat privacy.txt". */
  command: string;
  title: string;
}

const { command, title } = Astro.props;
---

<article class="textPage">
  <header class="textPageHeader">
    <p class="textPageCommand">{command}</p>
    <h1 class="textPageTitle">{title}<span class="textPageUnderscore" aria-hidden="true">_</span></h1>
  </header>
  <div class="textPageBody">
    <slot />
  </div>
</article>

<style>
  .textPage {
    display: grid;
    gap: var(--space-8);
    padding: var(--space-12) var(--page-gutter);
  }

  .textPageCommand {
    color: var(--color-muted);
    font-size: var(--font-size-small);
    line-height: var(--line-height-small);
  }

  .textPageTitle {
    font-size: var(--font-size-title);
    line-height: var(--line-height-title);
    letter-spacing: var(--letter-spacing-title);
    font-weight: var(--font-weight-bold);
  }

  .textPageUnderscore {
    color: var(--color-aurora);
  }

  .textPageBody {
    display: grid;
    gap: var(--space-4);
    max-width: 72ch;
    color: var(--color-text-body);
  }

  .textPageBody :global(h2) {
    margin-top: var(--space-6);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-line);
    color: var(--color-text);
    font-size: var(--font-size-wordmark);
    line-height: var(--line-height-body);
    letter-spacing: var(--letter-spacing-wordmark);
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
  }

  .textPageBody :global(ul) {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding-left: var(--space-6);
  }

  .textPageBody :global(strong) {
    color: var(--color-text);
    font-weight: var(--font-weight-bold);
  }
</style>
