---
// POLARIS-7's one line on every page, just above the footer: her face in today's mood,
// her name, one sentence that fits the page, the page's only blinking cursor, and the
// incident counter on the right.
//
// Screen readers hear it as one sentence, e.g. "POLARIS-7, neutral: The aurora, a quiet
// cluster and me. Days since last incident: 280". The face, the > and the
// cursor are visual only.
import PolaFace, { type PolaMood } from './PolaFace.astro';
import { incidentDays } from '../lib/doors';

interface Props {
  mood: PolaMood;
  /** One sentence in her voice that fits the page. */
  message: string;
}

const { mood, message } = Astro.props;
// Rendered at build time; the script below brings it up to date when the page loads.
const incidentCount = String(incidentDays(new Date())).padStart(2, '0');
---

<aside class="promptLine" aria-label="POLARIS-7">
  <p class="promptLineMessage">
    <PolaFace mood={mood} label={null} />
    <span class="promptLineName">POLARIS-7</span><span class="srOnly">, {mood}: </span>
    <span class="promptLinePrompt" aria-hidden="true">&gt;</span>
    <span class="promptLineText">{message}<span class="promptLineCursor" aria-hidden="true"> █</span></span>
  </p>
  <p class="promptLineIncidents">
    <span class="promptLineIncidentsLabel">days since last incident<span class="srOnly">: </span></span>
    <span class="promptLineIncidentsCount" data-incident-days>{incidentCount}</span>
  </p>
</aside>

<script>
  // Pages are prerendered, so the counter from the build can be days old.
  import { incidentDays } from '../lib/doors';

  const count = String(incidentDays(new Date())).padStart(2, '0');
  for (const element of document.querySelectorAll('[data-incident-days]')) element.textContent = count;
</script>

<style>
  .promptLine {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--color-line);
  }

  .promptLineMessage {
    display: flex;
    flex: 1;
    align-items: center;
    gap: var(--space-4);
    min-width: 0;
  }

  .promptLineName {
    font-size: var(--font-size-wordmark);
    line-height: var(--line-height-wordmark);
    letter-spacing: var(--letter-spacing-wordmark);
    font-weight: var(--font-weight-bold);
  }

  .promptLinePrompt {
    color: var(--color-muted);
  }

  .promptLineText {
    min-width: 0;
  }

  .promptLineCursor {
    color: var(--color-aurora);
    animation: promptLineBlink 1.1s steps(1) infinite;
  }

  @keyframes promptLineBlink {
    50% {
      opacity: 0;
    }
  }

  .promptLineIncidents {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding-left: var(--space-6);
    border-left: 1px solid var(--color-line);
  }

  .promptLineIncidentsLabel {
    color: var(--color-muted);
    font-size: var(--font-size-caps);
    line-height: var(--line-height-caps);
    letter-spacing: var(--letter-spacing-caps);
    text-transform: uppercase;
  }

  /* Small before launch, so the countdown stays the hero. December's large counter comes with the calendar. */
  .promptLineIncidentsCount {
    color: var(--color-text-soft);
  }

  /* Mobile: two rows like a terminal, her face and name above, the > under her face on the
     sentence's first line and the sentence under her name. No incident counter: there is
     no room for it beside her, and below her it competes with her line. */
  @media (max-width: 799px) {
    .promptLineMessage {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      gap: var(--space-1) var(--space-4);
    }

    .promptLinePrompt {
      align-self: start;
      justify-self: center;
    }

    /* Small, so it reads as the station's status line rather than more page content. */
    .promptLinePrompt,
    .promptLineText {
      font-size: var(--font-size-small);
      line-height: var(--line-height-small);
    }

    .promptLineIncidents {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .promptLineCursor {
      animation: none;
    }
  }
</style>
