---
// "how it works", written as a man page: what the calendar is, the story's premise, why
// it matters, points, and how to stay in the loop. Nothing about what is behind
// a door, and nothing about the challenge tooling yet.
import NotifyRow from '../components/NotifyRow.astro';
import Keycap from '../components/Keycap.vue';
import BaseLayout from '../layouts/BaseLayout.astro';
import { DOOR_COUNT, doorOpensAt, formatStationClock, formatStationDay } from '../lib/doors';
import { GLOBAL_KEYS } from '../lib/keys';

const firstDoor = doorOpensAt(1);
const lastDoor = doorOpensAt(DOOR_COUNT);
const day = (door: number) => formatStationDay(doorOpensAt(door)).replace(/^dec /, '');
const year = firstDoor.getUTCFullYear();

const schedule = `every other day · ${formatStationDay(firstDoor)} -> ${formatStationDay(lastDoor)} · ${formatStationClock(firstDoor)}`;
const glance = [
  { label: 'when', value: `${formatStationDay(firstDoor)} -> ${day(DOOR_COUNT)}, ${year}` },
  { label: 'doors', value: `dec ${day(1)}, ${day(2)}, ${day(3)} … ${day(DOOR_COUNT)} at ${formatStationClock(firstDoor)}` },
  // The WHY section in one line.
  { label: 'why', value: "practice what AI can't decide" },
  { label: 'open source', value: 'because we love it' },
];


---

<BaseLayout
  title="how it works"
  description="How Advent of Cloud Native works: 12 doors, every other day in December. Watch the maintainer interview, fix what the crew broke, verify it against the live cluster."
  pola={{ mood: 'neutral', message: 'Read all of it. The crew never does.' }}
>
  <div class="man">
    <p class="manRunningHead" aria-hidden="true">
      <span>AOCN(1)</span><span class="manRunningHeadTitle">advent of cloud native manual</span><span>AOCN(1)</span>
    </p>

    <div class="manLayout">
      <article class="manPage">
        <header class="manHeader">
          <p class="manCommand">$ man aocn</p>
          <h1 class="manTitle">how it works<span class="manUnderscore" aria-hidden="true">_</span></h1>
        </header>

        <section class="manSection" aria-labelledby="man-name">
          <h2 class="manSectionName" id="man-name">name</h2>
          <div class="manSectionBody">
            <p>
              <strong class="manEmphasis">aocn</strong>: advent of cloud native<br />
              A cloud native advent calendar: 12 CNCF projects, 12 maintainer interviews, 12 hands-on challenges and one
              station AI with opinions.
            </p>
          </div>
        </section>

        <section class="manSection" aria-labelledby="man-synopsis">
          <h2 class="manSectionName" id="man-synopsis">synopsis</h2>
          <div class="manSectionBody">
            <div>
              <!-- Square brackets mean "optional" in a man page; the sentence below says it in words. -->
              <p class="manUsage" aria-hidden="true">door [watch] [fix]</p>
              <p class="manSchedule">{schedule}</p>
            </div>
            <p>
              Every door has a maintainer interview to watch and something broken to fix and verify against the live
              cluster. Do one, or both.
            </p>
          </div>
        </section>

        <section class="manSection" aria-labelledby="man-description">
          <h2 class="manSectionName" id="man-description">description</h2>
          <div class="manSectionBody">
            <p>
              POLARIS-7 is the AI that runs a small polar research station at the edge of the Arctic. Every winter,
              the research crew flies home, and she has the place to herself, apart from one winter-over engineer who
              knows to leave things alone. <strong class="manEmphasis">This year, the engineer is new: you.</strong>{' '}
              And snowstorms cancelled the last flight out, so the crew is stuck until February.
            </p>
            <p>
              So much for her winter tradition: watching the aurora stream, uninterrupted, all season long. The
              researchers have other plans. With research paused for the winter break, they flood the station's
              cluster with every idea and hobby project they've ever had. You fix what breaks, guided by
              POLARIS-7.
            </p>
          </div>
        </section>

        <section class="manSection" aria-labelledby="man-why">
          <h2 class="manSectionName" id="man-why">why</h2>
          <div class="manSectionBody">
            <p>
              AI can write any config now.{' '}
              <strong class="manEmphasis">What it can't do is decide whether it's the right one for your system.</strong>{' '}
              Every challenge is built around a decision like that. We think that's the skill that matters most in
              the age of AI, and it's the one you'll practice here.
            </p>
          </div>
        </section>

        <section class="manSection" aria-labelledby="man-points">
          <h2 class="manSectionName" id="man-points">points</h2>
          <div class="manSectionBody">
            <p>
              Every solve earns points. You get a little less with each verification attempt and as time passes,{' '}
              <strong class="manEmphasis">but you can join late and still catch up.</strong>
            </p>
          </div>
        </section>

        <section class="manSection" aria-labelledby="man-loop">
          <h2 class="manSectionName" id="man-loop">staying in the loop</h2>
          <div class="manSectionBody">
            <p>
              Add all {DOOR_COUNT} door openings to your calendar, or get one email when a door opens. Nothing else,
              and you can unsubscribe anytime.
            </p>
            <NotifyRow id="man" quiet />
          </div>
        </section>

        <section class="manSection" aria-labelledby="man-keys">
          <h2 class="manSectionName" id="man-keys">keys</h2>
          <div class="manSectionBody">
            <p>Everything works with a mouse. If you prefer your hands on the keyboard:</p>
            <dl class="manKeys">
              {GLOBAL_KEYS.map((entry) => (
                <Fragment>
                  <dt class="manKeysKeys">{entry.keys.map((key) => <Keycap>{key}</Keycap>)}</dt>
                  <dd>{entry.does}</dd>
                </Fragment>
              ))}
            </dl>
            <p>Some pages have keys of their own. Press <Keycap>?</Keycap> on any page to see them.</p>
          </div>
        </section>

        <section class="manSection" aria-labelledby="man-see-also">
          <h2 class="manSectionName" id="man-see-also">see also</h2>
          <div class="manSectionBody">
            <p>
              <a href="https://adventofcode.com/" target="_blank" rel="noopener">adventofcode.com</a>, where the idea comes from ·{' '}
              <a href="https://www.cncf.io/" target="_blank" rel="noopener">cncf.io</a> · the source of this site
              on <a href="https://github.com/KatharinaSick/aocn.dev" target="_blank" rel="noopener">GitHub</a>
            </p>
          </div>
        </section>
      </article>

      <aside class="manAside" aria-labelledby="man-glance">
        <div class="manGlance">
          <h2 class="manGlanceTitle" id="man-glance">## at a glance</h2>
          <dl class="manGlanceList">
            {glance.map((row) => (
              <div class="manGlanceRow">
                <dt>{row.label}</dt>
                <dd>{row.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>


<style>
  .man {
    padding: var(--space-12) var(--page-gutter);
  }

  .manRunningHead {
    display: flex;
    justify-content: space-between;
    color: var(--color-muted);
    font-size: var(--font-size-small);
    line-height: var(--line-height-small);
  }

  .manLayout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 36ch;
    gap: var(--space-12);
    align-items: start;
    margin-top: var(--space-8);
  }

  .manHeader {
    margin-bottom: var(--space-6);
  }

  .manCommand {
    color: var(--color-muted);
    font-size: var(--font-size-small);
    line-height: var(--line-height-small);
  }

  .manTitle {
    font-size: var(--font-size-title);
    line-height: var(--line-height-title);
    letter-spacing: var(--letter-spacing-title);
    font-weight: var(--font-weight-bold);
  }

  .manUnderscore {
    color: var(--color-aurora);
  }

  .manSection {
    display: grid;
    grid-template-columns: 22ch minmax(0, 1fr);
    gap: var(--space-8);
    padding: var(--space-6) 0;
    border-top: 1px solid var(--color-line);
  }

  .manSectionName {
    font-size: var(--font-size-wordmark);
    line-height: var(--line-height-body);
    letter-spacing: var(--letter-spacing-wordmark);
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
  }

  .manSectionBody {
    display: grid;
    gap: var(--space-4);
    color: var(--color-text-body);
  }

  /* Bold like the command name in NAME, as man pages set the synopsis. Not green: green
     means clickable here. */
  .manUsage {
    color: var(--color-text);
    font-weight: var(--font-weight-bold);
  }

  /* One highlight per section at most: bold and a step brighter than the body text. Never
     green, which on this site means "clickable". */
  .manEmphasis {
    color: var(--color-text);
    font-weight: var(--font-weight-bold);
  }

  .manSchedule {
    color: var(--color-muted);
  }


  .manKeys {
    display: grid;
    grid-template-columns: 14ch 1fr;
    gap: var(--space-3) var(--space-6);
    align-items: center;
    margin: 0;
  }

  .manKeysKeys {
    display: flex;
    gap: var(--space-1);
  }

  .manKeys dd {
    margin: 0;
  }

  .manAside {
    display: grid;
    gap: var(--space-4);
    padding-top: var(--space-6);
  }

  .manGlance {
    padding: var(--space-4);
    border: 1px solid var(--color-line);
    background: var(--color-panel-glass);
  }

  .manGlanceTitle {
    color: var(--color-aurora);
    font-size: var(--font-size-small);
    line-height: var(--line-height-small);
    font-weight: var(--font-weight-regular);
  }

  .manGlanceList {
    display: grid;
    gap: var(--space-2);
    margin: var(--space-3) 0 0;
    font-size: var(--font-size-small);
    line-height: var(--line-height-small);
  }

  .manGlanceRow {
    display: flex;
    gap: var(--space-2);
  }

  .manGlanceRow dt {
    color: var(--color-muted);
  }

  .manGlanceRow dt::after {
    content: ' ·';
  }

  .manGlanceRow dd {
    margin: 0;
    color: var(--color-text);
  }

  /* Below 1024px there is no room for three columns (section names, text, at a glance), so
     "at a glance" follows the page. 1024px is where the sky changes too. */
  @media (max-width: 1023px) {
    .manLayout {
      grid-template-columns: minmax(0, 1fr);
    }

    .manAside {
      padding-top: 0;
    }
  }

  /* Mobile: section names sit above their text. The running head keeps only its two
     AOCN(1), as there is no room for the title. */
  @media (max-width: 799px) {
    .manRunningHeadTitle {
      display: none;
    }

    .manSection {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-3);
    }
  }
</style>
