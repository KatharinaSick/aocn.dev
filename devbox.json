{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.2/.schema/devbox.schema.json",
  "packages": [
    "go@1.27",
    "nodejs@24",
    "opentofu@1.12.5"
  ],
  "shell": {
    "scripts": {
      "api":   "go run -C api ./cmd/api-server",
      "web":   "npm run dev --prefix web",
      "build": "npm run build --prefix web",
      "test":  "go -C api test ./... && npm test --prefix web"
    }
  }
}
